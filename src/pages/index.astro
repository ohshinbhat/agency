---
import SiteLayout from '../layouts/SiteLayout.astro';
import { companies, projects, services } from '../content';
---
<SiteLayout title="First Run — Creative Agency" description="First Run is a creative agency for brands getting ready to launch. Explore our work and services.">
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="eyebrow hero-label"><span class="signal" aria-hidden="true"></span> Independent creative agency</span>
        <h1 id="hero-title">Off the<br /><em>blocks.</em></h1>
        <p>Brand strategy, design, and launch creative for teams ready to make their first move.</p>
        <a class="button button-red" href="#work">Explore our work <span aria-hidden="true">↓</span></a>
      </div>
      <figure class="hero-visual">
        <img src="/images/track.jpg" alt="Sprinter set at the starting line on a red running track" width="1200" height="800" fetchpriority="high" />
        <div class="hero-overlay" aria-hidden="true"><span>FIRST RUN</span><span class="lane">01</span></div>
      </figure>
    </div>
  </section>

  <section class="company-strip" aria-labelledby="companies-title">
    <div class="wrap company-inner">
      <h2 class="eyebrow" id="companies-title">Companies we’ve worked with</h2>
      {companies.length ? (
        <ul class="company-list">
          {companies.map(company => <li>{company.logo ? <img src={company.logo} alt={company.name} loading="lazy" /> : company.name}</li>)}
        </ul>
      ) : <p class="company-empty">Client names coming soon.</p>}
    </div>
  </section>

  <section id="work" class="wrap section work-section" aria-labelledby="work-title">
    <div class="section-head">
      <div>
        <p class="eyebrow">Portfolio</p>
        <h2 id="work-title">Selected work<span>.</span></h2>
      </div>
      <p class="section-note">Concept projects</p>
    </div>
    <div class="project-grid">
      {projects.map(project => (
        <article class="project">
          <img src={project.image} alt={project.alt} width="1050" height="700" loading="lazy" decoding="async" />
          <div class="project-copy">
            <p class="eyebrow">{project.type}</p>
            <h3>{project.name}</h3>
            <p>{project.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="services" class="services-section section" aria-labelledby="services-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Services</p>
          <h2 id="services-title">What we do<span>.</span></h2>
        </div>
        <a class="button button-outline" href="/contact/">Start a project <span aria-hidden="true">↗</span></a>
      </div>
      <div class="service-list">
        {services.map(service => (
          <article class="service">
            <h3>{service.name}</h3>
            <div>
              <p>{service.description}</p>
              <p class="service-deliverables">{service.deliverables}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</SiteLayout>
