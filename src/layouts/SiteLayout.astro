---
import '@fontsource/barlow-condensed/latin-700.css';
import '@fontsource/barlow-condensed/latin-800.css';
import '@fontsource/work-sans/latin-400.css';
import '@fontsource/work-sans/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  contact?: boolean;
}

const { title, description, contact = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5efe4" />
    <link rel="icon" href="/mark.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="wordmark" href="/" aria-label="First Run home"><span class="mark" aria-hidden="true"><i></i><i></i><i></i></span> FIRST RUN<span class="wordmark-period">.</span></a>
      <nav aria-label="Main navigation">
        <a href="/#work">Work</a>
        <a href="/#services">Services</a>
      </nav>
      <a class="button button-outline header-cta" href="/contact/" aria-current={contact ? 'page' : undefined}>Get in touch <span aria-hidden="true">↗</span></a>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <a class="wordmark" href="/" aria-label="First Run home"><span class="mark" aria-hidden="true"><i></i><i></i><i></i></span> FIRST RUN<span class="wordmark-period">.</span></a>
        <small>© {new Date().getFullYear()} First Run</small>
        {contact ? <a href="/">Back to home <span aria-hidden="true">↗</span></a> : <a href="/contact/">Start a project <span aria-hidden="true">↗</span></a>}
      </div>
    </footer>
  </body>
</html>
